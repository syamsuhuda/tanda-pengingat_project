# Gmail SMTP (wajib App Password 16 karakter, bukan password akun Google biasa)
GMAIL_USER=pengirim@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Pengingat Jadwal

# Email penerima utama dan eskalasi
PARTNER_EMAIL=pasangan@gmail.com
PARTNER_NAME=Pasangan
MY_EMAIL=email-saya@gmail.com

# Upstash Redis REST API (hanya REST, bukan koneksi TCP)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Keamanan (jalankan: npm run secrets:generate)
APP_PIN_HASH=replace_with_64_char_sha256_hex
SESSION_SECRET=replace_with_64_char_random_hex
CRON_SECRET=replace_with_64_char_random_hex
HMAC_SECRET=replace_with_64_char_random_hex

# URL publik aplikasi untuk tautan konfirmasi di email (opsional di Vercel, wajib untuk custom domain/lokal)
APP_URL=https://nama-proyek.vercel.app
